;------------------------------------------------------------------------------
; Uses the USB serial driver built into Windows (usbser.sys), via usbser.inf

[DriverInstall.NT]
Include=usbser.inf
Needs=UsbSerial_Install.NT

[DriverInstall.NT.Services]
Include=usbser.inf
Needs=UsbSerial_Install.NT.Services

