[Version]
Signature="$WINDOWS NT$"
Class=Ports
ClassGUID={4D36E978-E325-11CE-BFC1-08002BE10318}
Provider=%EMAS%
CatalogFile=usbcdc.cat
DriverVer=10/14/2026,6.1.7601.17515
PnpLockdown=1

[Manufacturer]
%EMAS%=DeviceList, NTx86, NTamd64

;------------------------------------------------------------------------------

[DeviceList.NTx86]
%CDCDEVICE%=DriverInstall,USB\VID_199B&PID_BA2E

[DeviceList.NTamd64]
%CDCDEVICE%=DriverInstall,USB\VID_199B&PID_BA2E

;------------------------------------------------------------------------------
; Uses the USB serial driver built into Windows (usbser.sys), via usbser.inf

[DriverInstall.NT]
Include=usbser.inf
Needs=UsbSerial_Install.NT

[DriverInstall.NT.Services]
Include=usbser.inf
Needs=UsbSerial_Install.NT.Services

;------------------------------------------------------------------------------

[Strings]
EMAS      = "MicroStrain by HBK Base Station Driver"
CDCDEVICE = "MicroStrain by HBK Base Station"
